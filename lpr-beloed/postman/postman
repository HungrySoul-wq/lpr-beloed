              "pm.test(\"Код 200\", () => pm.response.to.have.status(200));",
              "const body = pm.response.json();",
              "pm.test(\"Формат C: code, payload, timestamp, sign\", () => {",
              "  pm.expect(body.code).to.eql(200);",
              "  pm.expect(body.payload).to.be.an(\"array\");",
              "  pm.expect(body).to.have.property(\"timestamp\");",
              "  pm.expect(body.sign).to.include(\"beloed/\");",
              "});",
              "pm.test(\"per_page=2 и блок page\", () => {",
              "  pm.expect(body.payload.length).to.be.at.most(2);",
              "  pm.expect(body.page.size).to.eql(2);",
              "});",
              "pm.test(\"Сортировка по цене по убыванию\", () => {",
              "  const p = body.payload.map(t => t.price);",
              "  pm.expect(p).to.eql([...p].sort((a, b) => b - a));",
              "});"
            ]
          }
        }
